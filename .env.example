# Copy this file to .env, fill every required value, then run: docker compose up --build -d
# Generate WINDOWKEEPER_VAULT_KEY with: uv run windowkeeper vault generate-key

# Required secrets. Keep .env private; it is ignored by Git and Docker builds.
WINDOWKEEPER_ADMIN_PASSWORD=
WINDOWKEEPER_VAULT_KEY=

# Optional deployment settings.
WINDOWKEEPER_BIND_ADDRESS=127.0.0.1
WINDOWKEEPER_PORT=8787
WINDOWKEEPER_ROOT_PATH=
WINDOWKEEPER_COOKIE_SECURE=auto
WINDOWKEEPER_BROWSER_OAUTH_MODE=manual
